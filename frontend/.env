# Expo environment variables
# EXPO_PUBLIC_ prefix is required for variables to be available in the app bundle.
#
# Replace the IP below with your PC's local IP address if it changes.
# Run `ipconfig` on Windows to find it (look for "IPv4 Address").
#
# - Android emulator: use 10.0.2.2 (special alias for host machine)
# - Physical device / Expo Go: use your PC's LAN IP (e.g. 192.168.x.x or 172.x.x.x)
# - Web (browser): http://localhost:3000 works fine

EXPO_PUBLIC_API_URL=http://10.73.1.80:3000
